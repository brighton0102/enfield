---
import Logo from './Logo.astro';
import { company, navigation, services } from '@/data/site';
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-lead"><Logo light /><p>Supplying Zimbabwe with steel, cable, electrical and solar products backed by experienced, practical service.</p></div>
    <div><h2>Company</h2>{navigation.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}</div>
    <div><h2>Products</h2>{services.slice(0, 4).map((item) => <a href={`/services/#${item.slug}`}>{item.name}</a>)}</div>
    <div><h2>Contact</h2><a href={company.phoneHref}>{company.phone}</a><a href={`mailto:${company.email}`}>{company.email}</a><p>{company.address}</p></div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getFullYear()} {company.name}. Registration {company.registration}.</p><div><a href="/privacy/">Privacy</a><a href="/cookies/">Cookies</a><a href="/terms/">Terms</a></div></div>
</footer>
