---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import ContactForm from '@/components/ContactForm.astro'; import { company } from '@/data/site';
---
<BaseLayout title="Contact Enfield Zimbabwe" description="Request a quotation or contact Enfield Zimbabwe in Southerton, Harare for steel, cable, electrical, solar and wire products."><PageHero eyebrow="Contact" title="Tell us what you need." intro="For the most useful response, include the product, size or grade, quantity, intended use and required date." /><section class="section contact-section"><div class="container contact-grid"><div><ContactForm /></div><aside><div class="contact-block"><p class="eyebrow">Sales enquiries</p><a class="contact-link" href={`mailto:${company.email}`}>{company.email}</a><a class="contact-link" href={company.phoneHref}>{company.phone}</a><p>Monday–Friday<br/>Business hours</p></div><div class="contact-block"><p class="eyebrow">Visit us</p><address>{company.address}<br/>{company.postal}</address><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Corner+Hobbs+Plymouth+Roads+Southerton+Harare" rel="noreferrer" target="_blank">Open in Google Maps</a></div><div class="contact-block"><p class="eyebrow">Company details</p><p>Registration: {company.registration}<br/>VAT: {company.vat}</p></div></aside></div></section></BaseLayout>
