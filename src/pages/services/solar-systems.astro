---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTASection from '@/components/CTASection.astro';
import { solarSystemGroups } from '@/data/solarSystems';
---

<BaseLayout title="Solar and backup power products" description="Explore Enfield Zimbabwe's solar systems, inverters, battery energy storage and portable solar lighting solutions.">
  <section class="category-hero"><div class="container category-hero-grid">
    <div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/services/">Products</a><span aria-hidden="true">/</span><span>Solar & backup power</span></nav><p class="eyebrow">Products & supply · Solar systems</p><h1>Solar & backup power</h1><p class="page-intro">Solar systems, inverters, battery storage and portable power solutions for homes, businesses and operational sites.</p><a class="button" href="/contact/?service=solar-systems">Request a solar quote</a></div>
    <div class="category-hero-image industrial-hero-image"><img src="/products/solar-systems/complete-solar-backup-system.jpg" alt="Complete solar backup system with panel, inverter and battery" width="992" height="1071" /></div>
  </div></section>

  <nav class="equipment-jump-nav solar-jump-nav" aria-label="Solar product categories"><div class="container">{solarSystemGroups.map((group, index) => <a href={`#${group.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{group.name}</a>)}</div></nav>

  <section class="section"><div class="container"><div class="section-heading split"><div><p class="eyebrow">Product range</p><h2>Practical solar and backup solutions.</h2></div><p>Share your expected electrical load, operating time, installation conditions and preferred system capacity so our team can help confirm a suitable configuration.</p></div>
    <div class="equipment-groups">{solarSystemGroups.map((group, index) => <article class="equipment-group" id={group.slug}>
      <div class="equipment-group-copy"><span>{String(index + 1).padStart(2, '0')}</span><p class="eyebrow">Solar & backup power</p><h2>{group.name}</h2><p>{group.description}</p><h3>Typical applications</h3><p>{group.applications}</p><a class="text-link" href={`/contact/?service=solar-systems&product=${encodeURIComponent(group.name)}`}>Enquire about this product</a></div>
      <div class="equipment-gallery">{group.images.map(([src, alt], imageIndex) => <figure class:list={[imageIndex === 0 && 'equipment-gallery-primary']}><img src={src} alt={alt} width="1024" height="1024" loading="lazy" /></figure>)}</div>
    </article>)}</div>
  </div></section>
  <CTASection title="Discuss your solar and backup power requirements." />
</BaseLayout>

