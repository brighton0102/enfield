---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTASection from '@/components/CTASection.astro';
import { industrialEquipmentGroups } from '@/data/industrialEquipment';
---

<BaseLayout title="Industrial equipment products" description="Explore Enfield Zimbabwe's electric motors, distribution transformers and industrial cable supply for operational and infrastructure requirements.">
  <section class="category-hero"><div class="container category-hero-grid">
    <div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/services/">Products</a><span aria-hidden="true">/</span><span>Industrial equipment</span></nav><p class="eyebrow">Products & supply · Industrial equipment</p><h1>Industrial equipment</h1><p class="page-intro">Electric motors, distribution transformers and heavy-duty cable supply for operational, engineering and infrastructure requirements.</p><a class="button" href="/contact/?service=industrial-equipment">Request an equipment quote</a></div>
    <div class="category-hero-image industrial-hero-image"><img src="/products/industrial-equipment/electric-motors-production.jpg" alt="Industrial electric motors arranged on a factory floor" width="1399" height="768" /></div>
  </div></section>

  <nav class="equipment-jump-nav" aria-label="Industrial equipment categories"><div class="container">{industrialEquipmentGroups.map((group, index) => <a href={`#${group.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{group.name}</a>)}</div></nav>

  <section class="section"><div class="container"><div class="section-heading split"><div><p class="eyebrow">Product range</p><h2>Equipment for demanding operations.</h2></div><p>Share the intended application, required capacity, quantity and site conditions so our team can help confirm a suitable product and specification.</p></div>
    <div class="equipment-groups">{industrialEquipmentGroups.map((group, index) => <article class="equipment-group" id={group.slug}>
      <div class="equipment-group-copy"><span>{String(index + 1).padStart(2, '0')}</span><p class="eyebrow">Industrial equipment</p><h2>{group.name}</h2><p>{group.description}</p><h3>Typical applications</h3><p>{group.applications}</p><a class="text-link" href={`/contact/?service=industrial-equipment&product=${encodeURIComponent(group.name)}`}>Enquire about this product</a></div>
      <div class="equipment-gallery">{group.images.map(([src, alt], imageIndex) => <figure class:list={[imageIndex === 0 && 'equipment-gallery-primary']}><img src={src} alt={alt} width="1399" height="1000" loading="lazy" /></figure>)}</div>
    </article>)}</div>
  </div></section>
  <CTASection title="Discuss your industrial equipment requirements." />
</BaseLayout>

