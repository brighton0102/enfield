---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import CTASection from '@/components/CTASection.astro';
const steps=[['01','Initial conversation','Tell us what you are buying, why it is needed and when you need it.'],['02','Requirement review','We check specifications, quantities, application and any delivery constraints.'],['03','Product matching','Our team identifies suitable products, available options and any points needing confirmation.'],['04','Quotation & planning','You receive a clear quotation and we align on order, payment and fulfilment details.'],['05','Supply coordination','We prepare and coordinate the order while keeping communication direct.'],['06','Ongoing support','We remain available for repeat orders, related products and new requirements.']];
---
<BaseLayout title="How we work" description="See how Enfield Zimbabwe handles enquiries, product matching, quotations, supply coordination and ongoing support."><PageHero eyebrow="How we work" title="A straightforward route from requirement to supply." intro="Good supply starts with a clear brief. Our process is designed to reduce uncertainty and keep commercial decisions moving." /><section class="section"><div class="container timeline">{steps.map(([n,title,text]) => <article><span>{n}</span><div><h2>{title}</h2><p>{text}</p></div></article>)}</div></section><section class="section surface"><div class="container story-grid"><div><p class="eyebrow">Help us respond quickly</p><h2>What to include in your enquiry.</h2></div><ul class="check-list"><li>Product name, grade, size or relevant standard</li><li>Required quantity or bill of quantities</li><li>Intended application, where useful</li><li>Preferred delivery or collection date</li><li>Delivery location and site constraints</li><li>Supporting drawings, schedules or reference photos</li></ul></div></section><CTASection /></BaseLayout>
