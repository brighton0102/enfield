---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTASection from '@/components/CTASection.astro';
import { clients, services } from '@/data/site';
---
<BaseLayout title="Steel, cables and electrical supplies in Zimbabwe" description="Enfield Zimbabwe supplies quality steel, cables, electrical, solar and wire products with experienced service from Southerton, Harare.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy"><p class="eyebrow">Built on supply. Backed by experience.</p><h1>The materials that keep Zimbabwe moving.</h1><p class="hero-intro">Quality steel and electrical products, expert service, competitive prices. From a single requirement to a major project, Enfield helps customers source with confidence.</p><div class="button-row"><a class="button" href="/contact/">Request a quote</a><a class="button button-ghost" href="/services/">Explore our range</a></div></div>
      <div class="hero-visual" aria-label="Solar panels, electrical cables and an inverter"><img src="/hero-cables.png" width="1920" height="1080" alt="Solar panels with coils of electrical cable and an inverter" fetchpriority="high" /></div>
    </div>
    <div class="container trust-strip"><div><strong>85+</strong><span>years of company history</span></div><div><strong>6</strong><span>core product categories</span></div><div><strong>Harare</strong><span>coordinated supply across Zimbabwe</span></div><div><strong>298/48</strong><span>company registration</span></div></div>
  </section>

  <section class="section"><div class="container"><div class="section-heading split"><div><p class="eyebrow">Our product range</p><h2>One reliable source for essential materials.</h2></div><p>We bring together technical products that businesses, contractors and institutions need to build, maintain and operate.</p></div><div class="service-list">{services.map((service) => <a class="service-row" href={`/services/#${service.slug}`}><span>{service.number}</span><div><h3>{service.name}</h3><p>{service.summary}</p></div><b aria-hidden="true">↗</b></a>)}</div></div></section>

  <section class="section surface"><div class="container editorial-grid"><div class="sticky-copy"><p class="eyebrow">Why Enfield</p><h2>Experience that translates into practical support.</h2><p>Our long-standing knowledge of products, source markets and project requirements helps customers make clear purchasing decisions.</p><a class="text-link" href="/about/">More about Enfield</a></div><div class="principles"><article><span>01</span><h3>Broad, relevant range</h3><p>Steel, cable, electrical, solar, wire and automotive categories under one experienced supplier.</p></article><article><span>02</span><h3>Commercially grounded</h3><p>We focus on fit-for-purpose products, responsive service and competitive pricing.</p></article><article><span>03</span><h3>Project capability</h3><p>Decades of sourcing and supply-chain experience support both everyday orders and capital-dependent projects.</p></article><article><span>04</span><h3>Quality commitment</h3><p>Our mission puts quality products, professional technical service and customer satisfaction first.</p></article></div></div></section>

  <section class="section process-home"><div class="container"><div class="section-heading split"><div><p class="eyebrow">How we work</p><h2>Clear steps. Responsive supply.</h2></div><a class="text-link" href="/how-we-work/">See our full process</a></div><ol class="process-line"><li><span>01</span><h3>Understand</h3><p>We clarify specification, quantity, timing and destination.</p></li><li><span>02</span><h3>Source</h3><p>We identify the right products and confirm availability.</p></li><li><span>03</span><h3>Supply</h3><p>We coordinate the order and keep communication clear.</p></li><li><span>04</span><h3>Support</h3><p>We remain available for follow-on requirements.</p></li></ol></div></section>

  <section class="section client-section"><div class="container"><p class="eyebrow">Organisations named in our company profile</p><h2>Trusted across industry and infrastructure.</h2><div class="client-grid">{clients.map((client) => <span>{client}</span>)}</div><p class="source-note">Client names are reproduced from Enfield’s supplied corporate profile.</p></div></section>
  <CTASection title="Tell us what your project requires." />
</BaseLayout>
