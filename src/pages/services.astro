---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import CTASection from '@/components/CTASection.astro'; import { services } from '@/data/site';
---
<BaseLayout title="Steel, cable, electrical and solar products" description="Explore Enfield Zimbabwe’s range of cables, engineering steel, electrical equipment, solar, wire products and automotive supplies."><PageHero eyebrow="Products & supply" title="A broad product range, matched to real operational needs." intro="We supply core materials and equipment for contractors, utilities, manufacturers, institutions, farms, workshops and households." /><section class="section"><div class="container product-sections">{services.map((service) => <article id={service.slug} class="product-section"><div class="product-number">{service.number}</div><div><p class="eyebrow">{service.name}</p><h2>{service.summary}</h2></div><div><h3>What we supply</h3><p>{service.detail}</p><h3>Who it is for</h3><p>{service.for}</p><a class="text-link" href={`/contact/?service=${service.slug}`}>Ask about {service.name.toLowerCase()}</a></div></article>)}</div></section><section class="section surface"><div class="container note-panel"><div><p class="eyebrow">Specifications matter</p><h2>Need a particular size, grade or configuration?</h2></div><p>Share your bill of quantities, product specification or requirement list. Our team will confirm the closest available fit and discuss sourcing where needed.</p></div></section><CTASection title="Send us your product requirement." /></BaseLayout>
