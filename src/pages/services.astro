---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTASection from '@/components/CTASection.astro';
import { services } from '@/data/site';
import { cableCategories } from '@/data/cableCategories';
---

<BaseLayout title="Steel, cable, electrical and solar products" description="Explore Enfield Zimbabwe’s range of cables, engineering steel, electrical equipment, solar, wire products and automotive supplies.">
  <PageHero eyebrow="Products & supply" title="A broad product range, matched to real operational needs." intro="We supply core materials and equipment for contractors, utilities, manufacturers, institutions, farms, workshops and households." />
  <section class="section cable-catalogue" aria-labelledby="cable-catalogue-title"><div class="container">
    <div class="section-heading split"><div><p class="eyebrow">Enfield cables</p><h2 id="cable-catalogue-title">Cable solutions by application.</h2></div><p>Reliable cable products for mines, farms, energy projects, buildings and industrial operations.</p></div>
    <div class="cable-product-grid">{cableCategories.map((item) => <article class="cable-product-card"><a class="cable-product-image" href={`/services/cables/${item.slug}/`} aria-label={`View ${item.category} cable products`}><img src={item.image} alt={item.alt} width="1254" height="1254" loading="lazy" /></a><div class="cable-product-copy"><p class="eyebrow">{item.category}</p><h3><a href={`/services/cables/${item.slug}/`}>{item.title}</a></h3><p>{item.description}</p><a class="text-link" href={`/services/cables/${item.slug}/`}>View category details</a></div></article>)}</div>
  </div></section>
  <section class="section surface industrial-feature" aria-labelledby="industrial-equipment-title"><div class="container industrial-feature-grid">
    <a class="industrial-feature-image" href="/services/industrial-equipment/" aria-label="View industrial equipment products"><img src="/products/industrial-equipment/electric-motors-production.jpg" alt="Industrial electric motors arranged on a factory floor" width="1399" height="768" loading="lazy" /></a>
    <div class="industrial-feature-copy"><p class="eyebrow">Industrial equipment</p><h2 id="industrial-equipment-title">Motors, transformers and industrial cable supply.</h2><p>Explore practical equipment and cable solutions for manufacturing, mining, utilities, farms, workshops and infrastructure projects.</p><a class="text-link" href="/services/industrial-equipment/">View industrial equipment</a></div>
  </div></section>
  <section class="section solar-feature" aria-labelledby="solar-systems-title"><div class="container industrial-feature-grid">
    <a class="industrial-feature-image solar-feature-image" href="/services/solar-systems/" aria-label="View solar and backup power products"><img src="/products/solar-systems/complete-solar-backup-system.jpg" alt="Complete solar backup system with panel, inverter and battery" width="992" height="1071" loading="lazy" /></a>
    <div class="industrial-feature-copy"><p class="eyebrow">Solar & backup power</p><h2 id="solar-systems-title">Solar systems, inverters and battery storage.</h2><p>Explore practical solar generation, energy storage, backup power and portable lighting solutions for homes, businesses and operational sites.</p><a class="text-link" href="/services/solar-systems/">View solar systems</a></div>
  </div></section>
  <section class="section"><div class="container product-sections">{services.map((service) => <article id={service.slug} class="product-section"><div class="product-number">{service.number}</div><div><p class="eyebrow">{service.name}</p><h2>{service.summary}</h2></div><div><h3>What we supply</h3><p>{service.detail}</p><h3>Who it is for</h3><p>{service.for}</p><a class="text-link" href={`/contact/?service=${service.slug}`}>Ask about {service.name.toLowerCase()}</a></div></article>)}</div></section>
  <section class="section surface"><div class="container note-panel"><div><p class="eyebrow">Specifications matter</p><h2>Need a particular size, grade or configuration?</h2></div><p>Share your bill of quantities, product specification or requirement list. Our team will confirm the closest available fit and discuss sourcing where needed.</p></div></section>
  <CTASection title="Send us your product requirement." />
</BaseLayout>
